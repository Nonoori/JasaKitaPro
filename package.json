{
  "name": "jasakita-pro-marketplace",
  "version": "1.0.0",
  "description": "Platform Marketplace Jasa Harian & Langganan Fullstack (User, Mitra, Superadmin) - Cloudflare Pages + D1 + Midtrans + WhatsApp",
  "scripts": {
    "dev": "npx wrangler pages dev public --d1=DB --local",
    "db:init": "npx wrangler d1 execute jasakita_db --local --file=./db/schema.sql",
    "db:seed": "npx wrangler d1 execute jasakita_db --local --file=./db/seed_dummy.sql",
    "db:clean": "npx wrangler d1 execute jasakita_db --local --file=./db/clean_dummy.sql",
    "deploy": "npx wrangler pages deploy public"
  }
}
